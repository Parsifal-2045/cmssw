<library file="PixelTrackTest.cc" name="PixelTrackTest">
  <use name="boost"/>
  <use name="root"/>
  <use name="DataFormats/Common"/>
  <use name="DataFormats/TrackReco"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/MessageLogger"/>
  <use name="FWCore/ParameterSet"/>
  <flags EDM_PLUGIN="1"/>
</library>

<bin file="RZLine_catch2.cc" name="testRecoPixelVertexingPixelTrackFittingRZLine">
  <use name="catch2"/>
  <use name="RecoTracker/PixelTrackFitting"/>
</bin>

<bin file="testFits.cpp">
  <use name="eigen"/>
  <flags CXXFLAGS="-g"/>
</bin>

<bin file="testFits.cpp" name="testBrokenLineFit">
  <use name="eigen"/>
  <use name="RecoTracker/PixelTrackFitting"/>
  <flags CXXFLAGS="-g -DUSE_BL"/>
</bin>

<bin file="testFits.cpp" name="testFitsDump">
  <use name="eigen"/>
  <flags CXXFLAGS="-g -DRFIT_DEBUG"/>
</bin>

<bin file="PixelTrackFits.cc">
  <use name="eigen"/>
  <use name="root"/>
  <flags CXXFLAGS="-DEIGEN_NO_DEBUG -O2"/>
</bin>

<bin file="PixelTrackFits.cc" name="PixelTrackBrokenLineFit">
  <use name="eigen"/>
  <use name="root"/>
  <use name="RecoTracker/PixelTrackFitting"/>
  <flags CXXFLAGS="-DEIGEN_NO_DEBUG -DUSE_BL"/>
</bin>

<bin file="PixelTrackFits.cc" name="PixelTrackFits_Debug">
  <use name="eigen"/>
  <use name="root"/>
  <flags CXXFLAGS="-g"/>
</bin>

<bin file="testEigenJacobian.cpp">
  <use name="eigen"/>
  <use name="DataFormats/GeometrySurface"/>
  <use name="MagneticField/Engine"/>
  <use name="TrackingTools/AnalyticalJacobians"/>
  <use name="TrackingTools/TrajectoryParametrization"/>
  <flags CXXFLAGS="-g"/>
</bin>


<!-- The Landau energy-loss law of a composite ionization column (GeneralBrokenLine.h). -->
<bin file="testBLElossColumn.cc" name="testBLElossColumn">
  <use name="eigen"/>
  <use name="RecoTracker/PixelTrackFitting"/>
</bin>

<!-- Regeneration of the compiled-in material table (blMaterialMap/blMaterialMapRun.sh): needs step trees as
     arguments; NO_TESTRUN skips the argument-less runtests. -->
<bin file="blMaterialMap/blMaterialMapBuild.cc" name="blMaterialMapBuild">
  <use name="root"/>
  <flags NO_TESTRUN="1"/>
</bin>

<!-- SimWatcher that writes the run's Geant4 material table (density, X0, electron density, I, Sternheimer
     parameters) next to the step trees; blMaterialMapBuild reads the dE/dx weights from it. -->
<library file="blMaterialMap/BLMaterialTableDump.cc" name="RecoTrackerPixelTrackFittingBLMaterialTableDump">
  <use name="geant4core"/>
  <use name="clhep"/>
  <use name="FWCore/ParameterSet"/>
  <use name="SimG4Core/Notification"/>
  <use name="SimG4Core/Watcher"/>
  <flags EDM_PLUGIN="1"/>
</library>

<!-- Checks the two EventSetup maps the fits read against their sources (blMapsCheck_cfg.py). -->
<library file="BLMapsCheck.cc" name="RecoTrackerPixelTrackFittingTestBLMapsCheck">
  <use name="DataFormats/GeometryVector"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/MessageLogger"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
  <use name="MagneticField/Engine"/>
  <use name="MagneticField/Records"/>
  <use name="RecoTracker/PixelTrackFitting"/>
  <use name="RecoTracker/Record"/>
  <flags EDM_PLUGIN="1"/>
</library>
<test name="testBLMapsCheck" command="cmsRun ${LOCALTOP}/src/RecoTracker/PixelTrackFitting/test/blMapsCheck_cfg.py"/>
<bin file="testPerigeeJacobian.cc" name="testPerigeeJacobian">
  <use name="eigen"/>
  <use name="DataFormats/GeometryVector"/>
  <use name="RecoTracker/PixelTrackFitting"/>
  <use name="DataFormats/GeometrySurface"/>
  <use name="DataFormats/TrajectoryState"/>
  <flags CXXFLAGS="-g"/>
</bin>
